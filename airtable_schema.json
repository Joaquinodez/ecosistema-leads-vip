{
  "base": {
    "id": "app3PoaFFyXzghbx2",
    "name": "Ecosistema Leads VIP"
  },
  "tables": [
    {
      "name": "Leads",
      "id": "tblCqhr8ehXv8PyNG",
      "role": "Memoria central: 1 fila por lead; Estado es la maquina de estados",
      "fields": [
        {
          "name": "Nombre_Lead",
          "type": "singleLineText",
          "primary": true,
          "fieldId": "fldJ5scW16FqQsFnv"
        },
        {
          "name": "Email",
          "type": "email",
          "fieldId": "fldwLfO0hjRsAdyhw",
          "note": "clave de deduplicacion (minusculas)"
        },
        {
          "name": "Empresa",
          "type": "singleLineText",
          "fieldId": "fldShL1coeFxWzERD"
        },
        {
          "name": "Cargo",
          "type": "singleLineText",
          "fieldId": "flduHQ2aaxkzanZn1"
        },
        {
          "name": "Telefono",
          "type": "phoneNumber",
          "fieldId": "fldqoVDpPyWN38G3x"
        },
        {
          "name": "Mensaje",
          "type": "multilineText",
          "fieldId": "fldK3oHp97QmdNO7n",
          "note": "truncado a 4000 caracteres en n8n"
        },
        {
          "name": "Presupuesto_Estimado_USD",
          "type": "currency",
          "fieldId": "fldPc4hmbfw2BCoin"
        },
        {
          "name": "Tamano_Empresa_Empleados",
          "type": "number",
          "fieldId": "fldDMdlK5fYvMNBeX"
        },
        {
          "name": "Fuente",
          "type": "singleSelect",
          "choices": [
            "Formulario_Web",
            "Referido",
            "Evento",
            "LinkedIn",
            "Otro"
          ],
          "fieldId": "fldCrQIyUmqp5UCXk"
        },
        {
          "name": "Fecha_Ingreso",
          "type": "dateTime",
          "fieldId": "fld37WsTe66oOohGC"
        },
        {
          "name": "Estado",
          "type": "singleSelect",
          "choices": [
            "Pendiente",
            "Procesado_por_IA",
            "Esperando_Aprobacion",
            "Aprobado_por_Humano",
            "Rechazado",
            "Completado",
            "Error_Datos_Faltantes",
            "Error_API"
          ],
          "fieldId": "fldsCJy3uVhkDOSdI"
        },
        {
          "name": "Score_VIP",
          "type": "number",
          "range": "0-100",
          "fieldId": "fldaXBe562WiqMirO"
        },
        {
          "name": "Categoria_IA",
          "type": "singleSelect",
          "choices": [
            "VIP",
            "Calificado",
            "Descarte"
          ],
          "fieldId": "fldl6oDd2eNJm3yJr"
        },
        {
          "name": "Razonamiento_IA",
          "type": "multilineText",
          "fieldId": "fldJwBiC7IcGSrLrb"
        },
        {
          "name": "Fecha_Contacto",
          "type": "dateTime",
          "fieldId": "fldCwL3ViPjUiNtEc"
        },
        {
          "name": "Decision_Humana",
          "type": "singleSelect",
          "choices": [
            "Aprobado",
            "Rechazado",
            "Expirado",
            "No_Aplica"
          ],
          "fieldId": "fldWDfH6Gd6rH34k0"
        },
        {
          "name": "Fecha_Decision",
          "type": "dateTime",
          "fieldId": "fldBhVd0ovIL0chVj"
        },
        {
          "name": "Modelo_Clasificacion",
          "type": "singleLineText",
          "fieldId": "fldwueqcEoJbv61Jm"
        },
        {
          "name": "Tokens_Entrada",
          "type": "number",
          "fieldId": "flderE0dO1z15aWRH"
        },
        {
          "name": "Tokens_Salida",
          "type": "number",
          "fieldId": "fldFyNnQWtlBvDtJj"
        },
        {
          "name": "Errores",
          "type": "multipleRecordLinks",
          "linkedTable": "Errores",
          "fieldId": "fldqVOhQtLGGVgA7B"
        },
        {
          "name": "Interacciones",
          "type": "multipleRecordLinks",
          "linkedTable": "Interacciones",
          "fieldId": "fldBxYdrIHEMAFCKA"
        },
        {
          "name": "Num_Errores",
          "type": "count",
          "of": "Errores",
          "fieldId": "fldRjckeZX2vZkz7S"
        },
        {
          "name": "Con_Error",
          "type": "formula",
          "formula": "IF({Num_Errores}>0,1,0)",
          "fieldId": "fld58tRzBeJX7dlvp"
        },
        {
          "name": "Minutos_hasta_Contacto",
          "type": "formula",
          "formula": "DATETIME_DIFF(Fecha_Contacto, Fecha_Ingreso, 'minutes')",
          "fieldId": "fldRwJjYUs4mWa5XH"
        },
        {
          "name": "Costo_IA_microUSD",
          "type": "formula",
          "formula": "Tokens_Entrada*1 + Tokens_Salida*5",
          "fieldId": "fldCe0sxJbeBg8C2j",
          "note": "solo cubre la llamada de scoring (Haiku 4.5)"
        }
      ]
    },
    {
      "name": "Errores",
      "id": "tblq4Yr3ApSd6zMNm",
      "role": "Registro de resiliencia",
      "fields": [
        {
          "name": "Descripcion_Error",
          "type": "singleLineText",
          "primary": true
        },
        {
          "name": "Lead",
          "type": "multipleRecordLinks",
          "linkedTable": "Leads"
        },
        {
          "name": "Nodo_Origen",
          "type": "singleSelect",
          "choices": [
            "Webhook_Trigger",
            "Validacion_Datos",
            "Claude_Clasificacion",
            "Airtable_Update",
            "Gmail_Aprobacion",
            "Gmail_Envio_Cliente"
          ]
        },
        {
          "name": "Tipo_Error",
          "type": "singleSelect",
          "choices": [
            "Datos_Faltantes",
            "Timeout_API",
            "Error_Autenticacion",
            "Formato_Invalido",
            "Rate_Limit",
            "Otro"
          ]
        },
        {
          "name": "Mensaje_Error",
          "type": "multilineText",
          "note": "data minimization: solo campos faltantes o mensaje tecnico truncado a 500 caracteres"
        },
        {
          "name": "Fecha",
          "type": "dateTime"
        },
        {
          "name": "Reintentos",
          "type": "number"
        },
        {
          "name": "Estado_Resolucion",
          "type": "singleSelect",
          "choices": [
            "Pendiente",
            "Reintentado_OK",
            "Escalado_Manual"
          ]
        }
      ]
    },
    {
      "name": "Interacciones",
      "id": "tblhI4ofhRgVmcbUX",
      "role": "Log de comunicaciones y mapeo de Thread ID",
      "fields": [
        {
          "name": "Titulo_Interaccion",
          "type": "singleLineText",
          "primary": true
        },
        {
          "name": "Lead",
          "type": "multipleRecordLinks",
          "linkedTable": "Leads"
        },
        {
          "name": "Tipo",
          "type": "singleSelect",
          "choices": [
            "Email_Aprobacion_HITL",
            "Email_Cliente_VIP",
            "Nota_Interna"
          ]
        },
        {
          "name": "Canal",
          "type": "singleSelect",
          "choices": [
            "Gmail"
          ]
        },
        {
          "name": "Fecha",
          "type": "dateTime"
        },
        {
          "name": "Thread_ID",
          "type": "singleLineText",
          "note": "threadId devuelto por Gmail al enviar; enlaza la conversacion"
        },
        {
          "name": "Resumen",
          "type": "multilineText"
        }
      ]
    }
  ],
  "state_machine": {
    "Pendiente": [
      "Procesado_por_IA",
      "Error_API"
    ],
    "Procesado_por_IA": [
      "Esperando_Aprobacion (VIP)",
      "Completado (Calificado o Descarte)",
      "Error_API"
    ],
    "Esperando_Aprobacion": [
      "Aprobado_por_Humano",
      "Rechazado (rechazo o timeout; Decision_Humana distingue)",
      "Error_API"
    ],
    "Aprobado_por_Humano": [
      "Completado",
      "Error_API"
    ]
  }
}