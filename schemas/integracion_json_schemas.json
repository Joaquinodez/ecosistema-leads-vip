{
  "webhook_entrada": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "POST /webhook/nuevo-lead-vip (body)",
    "type": "object",
    "required": [
      "nombre",
      "email"
    ],
    "properties": {
      "nombre": {
        "type": "string",
        "minLength": 1
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "empresa": {
        "type": "string"
      },
      "cargo": {
        "type": "string"
      },
      "telefono": {
        "type": "string"
      },
      "mensaje": {
        "type": "string"
      },
      "presupuesto_estimado_usd": {
        "type": "number",
        "minimum": 0
      },
      "tamano_empresa_empleados": {
        "type": "number",
        "minimum": 0
      },
      "fuente": {
        "type": "string",
        "enum": [
          "Formulario_Web",
          "Referido",
          "Evento",
          "LinkedIn",
          "Otro"
        ]
      }
    }
  },
  "gmail_trigger_campos_usados": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Item del Gmail Trigger (simple=false), solo campos usados",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "threadId": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "from": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "value": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "text": {
        "type": "string"
      },
      "snippet": {
        "type": "string"
      }
    }
  },
  "claude_relevancia_extraccion_respuesta": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JSON que Haiku devuelve dentro de content[0].text",
    "type": "object",
    "required": [
      "es_consulta_relevante"
    ],
    "properties": {
      "es_consulta_relevante": {
        "type": "boolean"
      },
      "motivo_relevancia": {
        "type": "string"
      },
      "nombre": {
        "type": "string"
      },
      "empresa": {
        "type": "string"
      },
      "cargo": {
        "type": "string"
      },
      "telefono": {
        "type": "string"
      },
      "presupuesto_estimado_usd": {
        "type": "number",
        "minimum": 0
      },
      "tamano_empresa_empleados": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "claude_scoring_respuesta": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JSON de scoring cualitativo (Haiku)",
    "type": "object",
    "required": [
      "puntaje_cargo",
      "puntaje_urgencia"
    ],
    "properties": {
      "razonamiento_paso_a_paso": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "puntaje_cargo": {
        "type": "number",
        "minimum": 0,
        "maximum": 20
      },
      "puntaje_urgencia": {
        "type": "number",
        "minimum": 0,
        "maximum": 20
      }
    },
    "note": "presupuesto (0/15/30) y tamano (0/10/20) los calcula el nodo Code con umbrales de Config; el total y la categoria tambien"
  },
  "claude_borrador_respuesta": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JSON del borrador (Sonnet 5)",
    "type": "object",
    "required": [
      "asunto",
      "cuerpo"
    ],
    "properties": {
      "asunto": {
        "type": "string"
      },
      "cuerpo": {
        "type": "string"
      }
    }
  },
  "anthropic_messages_request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "POST https://api.anthropic.com/v1/messages",
    "type": "object",
    "required": [
      "model",
      "max_tokens",
      "messages"
    ],
    "properties": {
      "model": {
        "type": "string",
        "description": "viene del nodo Config"
      },
      "max_tokens": {
        "type": "integer"
      },
      "temperature": {
        "type": "number"
      },
      "system": {
        "type": "string"
      },
      "messages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "const": "user"
            },
            "content": {
              "type": "string",
              "description": "datos del lead dentro de etiqueta de datos no confiables"
            }
          }
        }
      }
    },
    "headers": {
      "x-api-key": "<credencial Header Auth>",
      "anthropic-version": "2023-06-01"
    }
  },
  "config_nodo_parametros": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Nodo Config (fuente unica de parametros)",
    "type": "object",
    "properties": {
      "aprobador_email": {
        "type": "string"
      },
      "admin_email": {
        "type": "string"
      },
      "empresa_nombre": {
        "type": "string"
      },
      "descripcion_servicio": {
        "type": "string"
      },
      "modelo_clasificacion": {
        "type": "string",
        "default": "claude-haiku-4-5"
      },
      "modelo_redaccion": {
        "type": "string",
        "default": "claude-sonnet-5"
      },
      "max_tokens_clasificacion": {
        "type": "integer",
        "default": 600
      },
      "max_tokens_redaccion": {
        "type": "integer",
        "default": 800
      },
      "umbral_vip": {
        "type": "number",
        "default": 80
      },
      "umbral_calificado": {
        "type": "number",
        "default": 50
      },
      "presupuesto_alto_usd": {
        "type": "number",
        "default": 20000
      },
      "presupuesto_medio_usd": {
        "type": "number",
        "default": 5000
      },
      "empleados_alto": {
        "type": "number",
        "default": 100
      },
      "empleados_medio": {
        "type": "number",
        "default": 20
      },
      "horas_espera_aprobacion": {
        "type": "number",
        "default": 48
      }
    }
  },
  "gmail_send_and_wait_resultado": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Salida del nodo HITL (Send and Wait, double approval)",
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "approved": {
            "type": "boolean"
          }
        }
      }
    },
    "note": "sin respuesta en el plazo: no hay data.approved y el Switch usa la salida fallback (Expirado)"
  },
  "airtable_error_registro": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Fila en Errores creada por el manejador unico",
    "type": "object",
    "required": [
      "Descripcion_Error",
      "Nodo_Origen",
      "Tipo_Error"
    ],
    "properties": {
      "Descripcion_Error": {
        "type": "string"
      },
      "Lead": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^rec"
        }
      },
      "Nodo_Origen": {
        "type": "string"
      },
      "Tipo_Error": {
        "type": "string"
      },
      "Mensaje_Error": {
        "type": "string",
        "maxLength": 500
      },
      "Fecha": {
        "type": "string",
        "format": "date-time"
      },
      "Reintentos": {
        "type": "integer"
      },
      "Estado_Resolucion": {
        "const": "Escalado_Manual"
      }
    }
  }
}